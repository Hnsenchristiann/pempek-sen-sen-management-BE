# ========== BACKEND PRODUCTION ENVIRONMENT (.env) ==========
# Copy ini ke BE\.env dan update dengan values Anda

PORT=3000

# Supabase PostgreSQL Connection String
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Dapatkan dari: Supabase Dashboard → Settings → Database → Connection String
MONGO_URI=postgresql://postgres:YOUR_PASSWORD@db.XXXX.supabase.co:5432/postgres

# JWT Secret (Generate dengan command di bawah)
# Command: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Copy hasil ke sini (contoh jangan pakai ini):
JWT_SECRET=a7f2e8b1c3d4f5g6h7i8j9k0l1m2n3o4p5q6r7s8t9u0v1w2x3y4z5a6b7c8d9

# CORS - Set ke URL Frontend Vercel
# Contoh: https://pempek-fe.vercel.app
CORS_ORIGIN=https://pempek-fe.vercel.app

# Environment
NODE_ENV=production
